        "run_text": "\u7248\u672c\uff1av0.3\uff08\u5bf9\u9f50 Stage-3 \u5de5\u7a0b\u3001\u8d85\u989d\u6536\u76ca Shapley\u3001\u5236\u5ea6\u8f68/\u8bc1\u636e\u8f68\u4e0e 53 \u9879\u56de\u5f52\u6d4b\u8bd5\uff09",
        "style": "Normal"
