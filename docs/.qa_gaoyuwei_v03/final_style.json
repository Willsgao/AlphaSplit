    ],
    "direct_paragraph_formatting": [
      {
        "para_index": 14,
        "text": "\u672c\u5206\u518c\u8986\u76d6\u6280\u672f\u6587\u6863\u5206\u5de5\u4e2d\u9ad8\u7389\u4f1f\u4e3b\u7b14/\u6536\u53e3\u5185\u5bb9\u3002\u76f4\u63a5\u8ba1\u91cf\u5bf9\u8c61\u4e3a\u6295\u7814\u4e94\u89d2\u8272\uff08\u884c\u4e1a\u3001\u4e2a\u80a1\u3001\u7b56\u7565\u3001\u91cf\u5316\u3001\u98ce\u63a7\u5206\u6790\u5e08\uff09\uff0c\u56e0\u5b50\u662f\u89d2\u8272\u51b3\u7b56\u8f93\u5165\u7684\u53ef\u89c2\u6d4b\u4ee3\u7406\u3002\u4e3b\u7ebf\u56de\u6d4b\u5f15\u64ce\u4ee5\u4e94\u89d2\u8272\u4e3a\u8054\u76df\u6210\u5458\uff0c\u904d\u5386 2^5=32 \u4e2a\u8054\u76df\uff0c\u4ee5\u76f8\u5bf9\u540c\u671f HS300 \u7684\u8d85\u989d\u6536\u76ca\u4e3a\u7279",
        "style": "Normal"
      },
      {
        "para_index": 15,
        "text": "\u672c\u6587\u4e2d\u7684\u67b6\u6784\u56fe\u4e0e\u6d41\u7a0b\u56fe\u7528\u4e8e\u8bf4\u660e\u673a\u5236\uff1b\u7b2c5.6\u8282\u6570\u503c\u8868\u548c Stage-3 \u7ed3\u679c\u56fe\u53d6\u81ea\u5f53\u524d\u5b8c\u6574\u771f\u5b9e\u56de\u6d4b\uff0c\u4f5c\u4e3a\u5b9a\u91cf\u7ed3\u8bba\u4f9d\u636e\u3002",
        "style": "Normal"
      },
      {
        "para_index": 17,
        "text": "\u3010\u8bf4\u660e\u3011\u4ee5\u4e0b\u5b9a\u91cf\u7ed3\u679c\u6765\u81ea stage3_20260825 \u5b8c\u6574\u771f\u5b9e\u56de\u6d4b\uff1b\u82e5\u7b2c6\u7ae0\u66f4\u6362\u6837\u672c\u533a\u95f4\uff0c\u5e94\u540c\u6b65\u66f4\u65b0\u672c\u7ae0\u6240\u6709\u7ed3\u679c\u4e0e\u56fe\u8868\u3002",
        "style": "Normal"
      },
      {
        "para_index": 18,
        "text": "\u8d44\u4ea7\u7ba1\u7406\u4e0e\u91cf\u5316\u6295\u7814\u662f\u5178\u578b\u7684\u591a\u89d2\u8272\u534f\u4f5c\u8fc7\u7a0b\uff1a\u884c\u4e1a\u7814\u7a76\u3001\u4e2a\u80a1\u7814\u7a76\u3001\u7b56\u7565\u62e9\u65f6\u3001\u91cf\u5316\u4fe1\u53f7\u4e0e\u98ce\u9669\u63a7\u5236\u7b49\u73af\u8282\u5171\u540c\u5f71\u54cd\u7ec4\u5408\u4e1a\u7ee9\u3002\u4f20\u7edf\u8003\u6838\u5f80\u5f80\u4f9d\u8d56\u56fa\u5b9a\u6bd4\u4f8b\u6216\u4e3b\u89c2\u8bc4\u8bae\uff0c\u96be\u4ee5\u56de\u7b54\u201c\u5404\u6295\u7814\u89d2\u8272\u5206\u522b\u8d21\u732e\u4e86\u591a\u5c11\u3001\u4f9d\u636e\u662f\u4ec0\u4e48\u201d\u3002\u7ecf\u5178\u4e1a\u7ee9\u5f52\u56e0\u80fd\u591f\u628a\u6536\u76ca\u62c6\u5230\u914d\u7f6e\u3001\u9009\u80a1\u6216\u98ce",
        "style": "Normal"
      },
      {
        "para_index": 19,
        "text": "AlphaSplit \u6784\u5efa\u201c\u591a\u667a\u80fd\u4f53\u9a71\u52a8\u7684\u6295\u7814\u89d2\u8272\u8d21\u732e\u8ba1\u91cf\u5e73\u53f0\u201d\uff1a\u4ee5\u4e94\u7c7b\u6295\u7814\u89d2\u8272\u4e3a\u8ba1\u91cf\u5bf9\u8c61\uff0c\u5728\u6caa\u6df1300\u6210\u5206\u80a1\u4e0e\u516c\u5f00\u884c\u60c5\u4e0a\u8fd0\u884c\u591a\u89d2\u8272 Pipeline\uff08\u884c\u4e1a\u914d\u7f6e\u2192\u4e2a\u80a1\u5019\u9009\u2192\u91cf\u5316\u4f18\u5316\u2192\u7b56\u7565\u62e9\u65f6\u2192\u98ce\u9669\u63a7\u5236\uff09\uff0c\u901a\u8fc7 32 \u4e2a\u89d2\u8272\u8054\u76df\u7684\u53cd\u4e8b\u5b9e\u56de\u6d4b\u8ba1",
        "style": "Normal"
      }
    ]
