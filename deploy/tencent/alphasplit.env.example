# Host-only port used by Nginx. Do not expose this port in the Tencent Cloud security group.
ALPHASPLIT_HOST_PORT=8766

# Recommended for a public judging/demo URL. Cached Agent responses and the
# prepared demo bundle remain available, while expensive real runs are blocked.
ALPHASPLIT_PUBLIC_DEMO_ONLY=1

# Optional. Leave blank in public demo mode. Never commit a real token or key.
ALPHASPLIT_API_TOKEN=
DEEPSEEK_API_KEY=

AGENT_LAYER_LLM_TIMEOUT=60
AGENT_LAYER_LLM_MAX_RETRIES=1
